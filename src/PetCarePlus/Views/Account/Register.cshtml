@{
    ViewData["Title"] = "Реєстрація";
}
<section class="form-card">
    <h1>Створіть акаунт PetCare+</h1>
    <form method="post" action="/api/auth/register" class="pc-form" data-api="json" data-api-mapping='{"email":"Email","username":"UserName","password":"Password","role":"Role"}'>
        <label for="email">Електронна пошта</label>
        <input id="email" name="email" type="email" placeholder="name@example.com" required />
        <label for="username">Ім'я користувача</label>
        <input id="username" name="username" type="text" required />
        <label for="password">Пароль</label>
        <input id="password" name="password" type="password" minlength="6" required />
        <label for="role">Роль</label>
        <select id="role" name="role" required>
            <option value="client">Клієнт</option>
            <option value="vet">Ветеринар</option>
        </select>
        <button type="submit" class="btn-primary">Зареєструватися</button>
    </form>
    <p class="form-footer">Вже маєте акаунт? <a asp-action="Login">Увійти</a></p>
</section>
