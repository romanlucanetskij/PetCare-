<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetCare+</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="pc-header">
        <div class="pc-container">
            <div class="pc-brand">
                <img src="~/images/logo.svg" alt="PetCare+" class="pc-logo" />
                <span>PetCare+</span>
            </div>
            <nav>
                <a asp-controller="Home" asp-action="Index">Головна</a>
                <a asp-controller="Dashboard" asp-action="Client">Кабінет</a>
                <a asp-controller="Home" asp-action="Privacy">Політика</a>
            </nav>
        </div>
    </header>
    <main role="main" class="pc-main">
        <div class="pc-container">
            @RenderBody()
        </div>
    </main>
    <footer class="pc-footer">
        <div class="pc-container">
            <p>© @DateTime.Now.Year PetCare+. Всі права захищені.</p>
        </div>
    </footer>
    <script src="~/js/auth.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
